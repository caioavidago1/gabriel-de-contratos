# ============================================
# API Keys de IA
# ============================================

# OpenAI API Key (Obrigatória)
# Para modelos: gpt-5.1, gpt-5-mini
# E embeddings: text-embedding-3-small, text-embedding-3-large
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_openai_api_key_aqui

# Anthropic API Key (Opcional)
# Para modelos Claude: claude-opus-4.5, claude-sonnet-4.5, claude-haiku-4.5
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sua_anthropic_api_key_aqui

# ============================================
# Senhas de Acesso
# ============================================

# Senha do administrador (para acesso ao modo admin)
ADMIN_PASSWORD=sua_senha_admin_aqui

# Senha da aplicação (para acesso geral à plataforma)
APP_PASSWORD=sua_senha_app_aqui

# ============================================
# LangSmith - Observabilidade (Opcional)
# ============================================

# Ativa o tracing automático de todas as operações LangChain/LangGraph
# Valores: true ou false
LANGCHAIN_TRACING_V2=false

# Endpoint da API do LangSmith (não precisa alterar)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Sua API Key do LangSmith
# Obtenha em: https://smith.langchain.com
LANGCHAIN_API_KEY=sua_langsmith_api_key_aqui

# Nome do projeto no LangSmith (para organizar seus traces)
LANGCHAIN_PROJECT=
